GROQ_API_KEY=your_groq_key_here
# EMBEDDING_PROVIDER can be google or huggingface.
EMBEDDING_PROVIDER=huggingface
HF_API_TOKEN=your_hugging_face_token_here
HF_EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
# GOOGLE_API_KEY=your_google_ai_studio_key_here
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
DATABASE_URL=postgresql://admin:admin@postgres:5432/ncert_platform
REDIS_URL=redis://redis:6379
VITE_API_URL=http://localhost:8000

# Clerk auth. CLERK_ISSUER is your Clerk instance's Frontend API URL (no secret
# key needed backend-side — JWTs are verified against the instance's public JWKS).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# LangSmith observability (Phase 4A, free tier). Leave LANGSMITH_TRACING unset
# or false to run with tracing off (zero-cost no-op) - nothing else here is
# read unless it's true. LangGraph nodes are traced automatically once this is
# on; agents/subject_agents.py and agents/tools.py additionally wrap the raw
# Groq calls and tool calls with @traceable so they show up nested inside each
# node's run instead of just as an opaque LLM call.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=daskalos
